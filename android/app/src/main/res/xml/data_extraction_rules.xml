<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" does not stop device-to-device transfer.
     Exclude everything from both cloud backup and device transfer. The database
     would be useless elsewhere anyway: its key is wrapped by a non-exportable
     Keystore key that never leaves this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
